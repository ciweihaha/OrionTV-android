<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/orion_bg"
    android:orientation="vertical"
    android:padding="@dimen/orion_safe_margin">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vod_title"
        android:textColor="@color/orion_gold"
        android:textSize="@dimen/orion_text_title"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/category_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/poster_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1" />

    <!-- Shown while the first page is loading (previously no loading
         state at all on page 1). -->
    <TextView
        android:id="@+id/loading_first"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="正在加载…"
        android:textColor="@color/orion_text_dim"
        android:textSize="@dimen/orion_text_body"
        android:visibility="gone" />

    <TextView
        android:id="@+id/empty_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/empty_hint"
        android:textColor="@color/orion_text_dim"
        android:textSize="@dimen/orion_text_body"
        android:visibility="gone" />

    <!-- Shown while a follow-up page is loading (round 9 pagination). -->
    <TextView
        android:id="@+id/loading_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:focusable="false"
        android:text="正在加载更多…"
        android:textColor="@color/orion_text_dim"
        android:textSize="@dimen/orion_text_body"
        android:visibility="gone" />
</LinearLayout>
