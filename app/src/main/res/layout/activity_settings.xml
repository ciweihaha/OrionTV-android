<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/orion_bg"
    android:orientation="vertical"
    android:padding="@dimen/orion_safe_margin">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textColor="@color/orion_gold"
        android:textSize="@dimen/orion_text_title"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/m3u_url_label"
        android:textColor="@color/orion_text"
        android:textSize="@dimen/orion_text_body" />

    <EditText
        android:id="@+id/m3u_url_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:hint="@string/m3u_url_hint"
        android:inputType="textUri"
        android:textColor="@color/orion_text"
        android:textColorHint="@color/orion_text_dim"
        android:textSize="@dimen/orion_text_body" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/save_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_gold"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="@string/save"
            android:textColor="@color/orion_bg"
            android:textSize="@dimen/orion_text_body" />

        <Button
            android:id="@+id/clear_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="@string/clear"
            android:textColor="@color/orion_text"
            android:textSize="@dimen/orion_text_body" />
    </LinearLayout>

    <TextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/orion_text_dim"
        android:textSize="@dimen/orion_text_body" />
</LinearLayout>
