<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_focusable"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/poster_image"
        android:layout_width="160dp"
        android:layout_height="240dp"
        android:contentDescription="@string/poster_desc"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/poster_title"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/orion_text"
        android:textSize="@dimen/orion_text_body" />

    <TextView
        android:id="@+id/poster_meta"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/orion_text_dim"
        android:textSize="@dimen/orion_text_meta" />
</LinearLayout>
