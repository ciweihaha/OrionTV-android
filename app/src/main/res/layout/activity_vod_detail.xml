<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/orion_bg"
    android:orientation="horizontal"
    android:padding="@dimen/orion_safe_margin">

    <ImageView
        android:id="@+id/detail_poster"
        android:layout_width="240dp"
        android:layout_height="360dp"
        android:contentDescription="@string/poster_desc"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="32dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/detail_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/orion_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detail_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/orion_text_dim"
            android:textSize="@dimen/orion_text_body" />

        <TextView
            android:id="@+id/detail_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/orion_error"
            android:textSize="@dimen/orion_text_body"
            android:visibility="gone" />

        <TextView
            android:id="@+id/detail_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:textColor="@color/orion_text_soft"
            android:textSize="@dimen/orion_text_body" />

        <!-- M12: playback-source chips, only shown with 2+ sources. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/source_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/play_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_gold"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:text="@string/play"
                android:textColor="@color/orion_bg"
                android:textSize="@dimen/orion_text_body" />

            <!-- Round 1: favourite toggle, wired to LibraryStore. -->
            <Button
                android:id="@+id/favorite_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_card_focusable"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:text="收藏"
                android:textColor="@color/orion_text"
                android:textSize="@dimen/orion_text_body" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/episodes_title"
            android:textColor="@color/orion_gold"
            android:textSize="@dimen/orion_text_section"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/episode_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
