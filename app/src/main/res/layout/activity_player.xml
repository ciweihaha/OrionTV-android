<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="false" />

    <!-- Top title bar -->
    <TextView
        android:id="@+id/player_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="48dp"
        android:textColor="@color/white"
        android:textSize="@dimen/orion_text_title"
        android:textStyle="bold" />

    <!-- Seek preview bubble (T7): direction + landing time -->
    <TextView
        android:id="@+id/seek_preview_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="72dp"
        android:background="@drawable/bg_bubble"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:textColor="@color/white"
        android:textSize="@dimen/orion_text_body"
        android:visibility="gone" />

    <!-- Skip-intro button (T5) -->
    <Button
        android:id="@+id/skip_intro_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="120dp"
        android:background="@drawable/bg_button_gold"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/skip_intro"
        android:textColor="@color/orion_bg"
        android:textSize="@dimen/orion_text_body"
        android:visibility="gone" />

    <!-- Bottom control bar -->
    <LinearLayout
        android:id="@+id/controls_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingTop="12dp"
        android:paddingEnd="48dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/play_pause_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_button_circle"
            android:text="▶"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/current_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="00:00"
            android:textColor="@color/white"
            android:textSize="@dimen/orion_text_small" />

        <SeekBar
            android:id="@+id/seek_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:max="100"
            android:progressTint="@color/orion_gold"
            android:thumbTint="@color/orion_gold" />

        <TextView
            android:id="@+id/duration_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textColor="@color/white"
            android:textSize="@dimen/orion_text_small" />
    </LinearLayout>
</FrameLayout>
